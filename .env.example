# Server
PORT=8787
# Defaults to 127.0.0.1. Public binds require API_AUTH_TOKEN unless explicitly marked unsafe.
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
API_AUTH_TOKEN=
ALLOW_UNAUTHENTICATED_PUBLIC_BIND=false

# Optional. Defaults to the repository root when running from this monorepo.
# Separate multiple roots with ":" on Linux/macOS and ";" on Windows.
WORKSPACE_ALLOWED_ROOTS=

# Optional model providers. The app works without these by using mock models.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_INPUT_COST_PER_MILLION=
ANTHROPIC_OUTPUT_COST_PER_MILLION=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_INPUT_COST_PER_MILLION=
OPENROUTER_OUTPUT_COST_PER_MILLION=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_INPUT_COST_PER_MILLION=
GEMINI_OUTPUT_COST_PER_MILLION=
